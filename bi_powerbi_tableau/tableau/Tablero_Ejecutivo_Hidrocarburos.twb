<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2023.3.0' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
  </preferences>
  <datasources>
    <datasource caption='Modelo_Estrella_Hidrocarburos' inline='true' name='federated.hidrocarburos' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Fact_Contraprestaciones_Hidrocarburos' name='textscan.fact'>
            <connection class='textscan' directory='../datasets_estrella' filename='Fact_Contraprestaciones_Hidrocarburos.csv' separator=',' />
          </named-connection>
        </named-connections>
      </connection>
      <column caption='Valor Contractual ($ MDP)' datatype='real' name='[VALOR_CONTRACTUAL_MDP]' role='measure' type='quantitative' />
      <column caption='Contraprestación y Regalías ($ MDP)' datatype='real' name='[CONTRAPRESTACION_MDP]' role='measure' type='quantitative' />
      <column caption='Equivalente USD ($ MDD)' datatype='real' name='[EQUIVALENTE_USD_MDD]' role='measure' type='quantitative' />
      <column caption='Government Take Efectivo (%)' datatype='real' name='[Calculation_GovTake]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([CONTRAPRESTACION_MDP]) / SUM([VALOR_CONTRACTUAL_MDP])' />
      </column>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='KPI_Regalias_Por_Regimen'>
      <table>
        <view>
          <datasources>
            <datasource caption='Modelo_Estrella_Hidrocarburos' name='federated.hidrocarburos' />
          </datasources>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.hidrocarburos].[sum:CONTRAPRESTACION_MDP:qk]</rows>
        <cols>[federated.hidrocarburos].[none:REGIMEN_CODIGO:nk]</cols>
      </table>
    </worksheet>
  </worksheets>
</workbook>
